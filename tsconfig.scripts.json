{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "scripts/**/*.mts",
    "src/lib/fixtures/**/*.ts",
    "src/lib/proof/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/lib/fixtures/**/*.test.ts",
    "src/lib/proof/**/*.test.ts"
  ]
}
