{
  "name": "stint",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:fixtures": "tsc --noEmit -p tsconfig.scripts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:auth": "E2E_AUTH_JOURNEY=1 playwright test e2e/auth-journey.spec.ts",
    "test:e2e:onboarding": "E2E_AUTH_JOURNEY=1 playwright test --workers=1 e2e/auth-journey.spec.ts e2e/onboarding-journey.spec.ts e2e/completion-journey.spec.ts e2e/matches-journey.spec.ts",
    "test:e2e:slice2": "E2E_AUTH_JOURNEY=1 playwright test --workers=1 e2e/slice2-critical-journey.spec.ts",
    "test:e2e:slice3": "E2E_AUTH_JOURNEY=1 playwright test --workers=1 e2e/slice3-critical-journey.spec.ts",
    "test:e2e:employer": "E2E_AUTH_JOURNEY=1 playwright test --workers=1 e2e/employer-onboarding-journey.spec.ts e2e/employer-vacancy-draft-journey.spec.ts e2e/employer-verification-journey.spec.ts e2e/internal-verification-journey.spec.ts e2e/employer-vacancy-lifecycle-journey.spec.ts",
    "test:e2e:public-jobs": "E2E_AUTH_JOURNEY=1 playwright test --workers=1 e2e/public-jobs-journey.spec.ts",
    "test:e2e:candidate-integration": "E2E_AUTH_JOURNEY=1 playwright test --workers=1 e2e/matches-journey.spec.ts e2e/job-detail-journey.spec.ts",
    "test:e2e:employer-applications": "E2E_AUTH_JOURNEY=1 playwright test --workers=1 e2e/employer-applicant-review-journey.spec.ts",
    "test:e2e:candidate-applications": "E2E_AUTH_JOURNEY=1 playwright test --workers=1 e2e/candidate-application-status-journey.spec.ts",
    "test:e2e:admin-moderation": "E2E_AUTH_JOURNEY=1 playwright test --workers=1 e2e/admin-moderation.spec.ts",
    "proof:migrations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/proof/migration-inventory.mts",
    "proof:slice4": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/proof/slice4.mts",
    "fixtures:hosted:apply": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/fixtures/hosted-demo.mts apply",
    "fixtures:hosted:cleanup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/fixtures/hosted-demo.mts cleanup",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:reset": "supabase db reset --yes",
    "supabase:test:db": "supabase test db",
    "test:db:lock": "STINT_DB_INTEGRATION=1 vitest run src/lib/onboarding/completion-lock.integration.test.ts",
    "db:types": "supabase gen types --local --lang typescript --schema public > src/types/database.ts",
    "db:types:check": "supabase gen types --local --lang typescript --schema public | diff -u src/types/database.ts -"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "pg": "^8.22.0",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "supabase": "2.111.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  }
}
