# Klinnova local environment example.
# Copy to `.env.local` for Next.js development (never commit real secrets):
#   cp .env.example .env.local
#
# After `pnpm supabase:start`, copy values from `pnpm supabase:status`.
# Prefer the CLI "Publishable" key. Older CLI output may label it "anon key";
# paste that browser-safe value into NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.

# --- Browser-safe (exposed to the client via NEXT_PUBLIC_*) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key

# Optional canonical origin for Auth email redirects (production: https://klinnova.com).
# Local default falls back to http://localhost:3000 when unset.
# Preview falls back to the Vercel deployment URL when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Sentry DSN (M5.1 Unit G). Sentry.init() no-ops without a DSN, so
# this is safe to leave unset locally. Production Sentry remains OFF/unwired
# by Founder decision unless separately authorized. Never set this to a value
# containing a secret; DSNs are public identifiers by design, but
# SENTRY_AUTH_TOKEN (source-map upload, build-time only) is a genuine secret
# and must never appear here or anywhere with a NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_SENTRY_DSN=

# --- Server-only ---
# Browser and ordinary SSR sessions use the publishable key + user cookies only.
# Privileged server secrets must never be exposed through NEXT_PUBLIC_*.

# Business transactional-email transport used by the implemented application
# mail flows under src/lib/mail/**. Required only when exercising those flows
# locally; leave unset otherwise.
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=
# MAIL_FROM_ADDRESS=

# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT are build-time-only
# source-map-upload inputs. Never expose them through NEXT_PUBLIC_*.
